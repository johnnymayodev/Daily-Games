---
import { getCollection } from "astro:content";

import { Dices } from "@lucide/astro";

import GameCard from "../components/GameCard.astro";
import Layout from "../layouts/Layout.astro";

const games = (await getCollection("games")).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Layout title="Daily Games">
  <input
    class="game-search mb-4 block w-full max-w-96 rounded-xl border border-neutral-200 bg-white px-3.5 py-2.5 text-black placeholder:text-neutral-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black md:mb-6 dark:border-neutral-800 dark:bg-black dark:text-white dark:placeholder:text-neutral-400 dark:focus-visible:outline-white"
    type="search"
    placeholder="Search games"
    aria-label="Search games by title"
    autocomplete="off"
  />
  <ul class="grid grid-cols-[repeat(auto-fill,minmax(min(10rem,100%),1fr))] gap-3 md:gap-4 lg:gap-5">
    {games.map((game) => <GameCard game={game} />)}
  </ul>
  <button
    class="random-game fixed right-4 bottom-[max(1rem,env(safe-area-inset-bottom))] z-10 grid size-12 cursor-pointer place-items-center rounded-full bg-black text-white shadow-lg transition duration-150 hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black sm:right-6 dark:bg-white dark:text-black dark:focus-visible:outline-white"
    type="button"
    aria-label="Open a random game"
  >
    <Dices />
  </button>
</Layout>

<script>
  const searchInput = document.querySelector<HTMLInputElement>(".game-search");
  const cards = document.querySelectorAll<HTMLElement>(".game-card");
  const randomButton = document.querySelector<HTMLButtonElement>(".random-game");
  const gameLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".game-link"));

  if (searchInput) {
    searchInput.addEventListener("input", () => {
      const query = searchInput.value.trim().toLowerCase();

      for (const card of cards) {
        const title = card.querySelector(".game-title")?.textContent?.trim().toLowerCase() ?? "";
        card.hidden = !title.includes(query);
      }
    });
  }

  if (randomButton && gameLinks.length > 0) {
    randomButton.addEventListener("click", () => {
      const link = gameLinks[Math.floor(Math.random() * gameLinks.length)];
      window.open(link.href, "_blank", "noopener");
    });
  }
</script>
