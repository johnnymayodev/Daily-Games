---
import { getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  game: CollectionEntry<"games">;
}

const { game } = Astro.props;

const accentPalette = [
  "bg-red-400/15 text-red-400",
  "bg-orange-400/15 text-orange-400",
  "bg-yellow-400/15 text-yellow-400",
  "bg-green-400/15 text-green-400",
  "bg-blue-400/15 text-blue-400",
  "bg-purple-400/15 text-purple-400",
  "bg-pink-400/15 text-pink-400",
];
const hash = [...game.data.title].reduce((sum, char) => sum + (char.codePointAt(0) ?? 0), 0);
const accent = accentPalette[hash % accentPalette.length];
const monogram = game.data.title.trim().charAt(0).toUpperCase();
const image = game.data.image ? await getImage({ src: game.data.image }) : null;
---

<li class="game-card" data-game-id={game.id}>
  <a
    class="game-link @container relative block aspect-square overflow-hidden rounded-xl border border-neutral-200 bg-neutral-950 transition duration-150 hover:-translate-y-0.5 hover:border-neutral-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black dark:border-neutral-800 dark:hover:border-neutral-400 dark:focus-visible:outline-white"
    target="_blank"
    href={game.data.url}
  >
    <div
      class={`game-monogram absolute inset-0 grid place-items-center pb-[12%] text-[50cqw] leading-none font-semibold ${accent}`}
      aria-hidden="true"
    >
      {monogram}
    </div>
    {
      image && (
        <img
          class="game-card-image absolute inset-0 h-full w-full object-cover"
          data-src={image.src}
          width={image.attributes.width}
          height={image.attributes.height}
          alt=""
          loading="lazy"
          decoding="async"
        />
      )
    }
    <span
      class="game-title absolute inset-x-0 bottom-0 bg-linear-to-t from-black/85 to-transparent px-3 pt-7 pb-2.5 text-[0.95rem] font-semibold tracking-[0.01em] text-white"
    >
      {game.data.title}
    </span>
  </a>
</li>

<script>
  import { applyCardImages, isCardImagesEnabled } from "../scripts/card-images";
  import { openInSafari } from "../scripts/open-in-browser";
  import { incrementPopularity } from "../scripts/popularity";

  applyCardImages(isCardImagesEnabled());

  // Counts the tap and re-orders the grid while the link opens, so the new
  // order is already in place when the player returns to this page.
  function recordGameTap(link: HTMLAnchorElement): void {
    const card = link.closest<HTMLElement>(".game-card");
    const grid = card?.parentElement;
    const gameId = card?.dataset.gameId;

    if (!grid || !gameId) {
      return;
    }

    const popularity = incrementPopularity(gameId);
    const cards = Array.from(grid.querySelectorAll<HTMLElement>(".game-card"));

    // The stable sort keeps the server-rendered title order for equal popularity.
    cards.sort((a, b) => (popularity[b.dataset.gameId ?? ""] ?? 0) - (popularity[a.dataset.gameId ?? ""] ?? 0));
    grid.append(...cards);
  }

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) {
      return;
    }

    const link = event.target.closest<HTMLAnchorElement>("a.game-link");

    if (!link) {
      return;
    }

    recordGameTap(link);

    if (openInSafari(link.href)) {
      event.preventDefault();
    }
  });
</script>
