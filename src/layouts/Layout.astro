---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "A museum for daily games." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta
      name="description"
      content={description}
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <h1 class="site-title">{title}</h1>
      </header>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  .site-shell {
    max-width: 75rem;
    margin-inline: auto;
    padding: clamp(1rem, 4vw, 2.5rem);
  }

  .site-header {
    margin-block: 0.5rem clamp(1rem, 3vw, 2rem);
  }

  .site-title {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-align: center;
    color: var(--muted);
  }
</style>
