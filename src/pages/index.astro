---
import { getCollection } from "astro:content";

import { Dices, X } from "@lucide/astro";

import GameCard from "../components/GameCard.astro";
import Layout from "../layouts/Layout.astro";

const games = (await getCollection("games")).sort(
  (a, b) =>
    a.data.popularityIndex - b.data.popularityIndex || a.data.title.localeCompare(b.data.title),
);
---

<Layout title="Daily Games">
  <div class="relative mb-4 w-full max-w-96 md:mb-6">
    <input
      class="game-search block w-full rounded-xl border border-neutral-200 bg-white px-3.5 py-2.5 pr-10 text-black placeholder:text-neutral-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black md:pr-3.5 dark:border-neutral-800 dark:bg-black dark:text-white dark:placeholder:text-neutral-400 dark:focus-visible:outline-white"
      type="search"
      placeholder="Search games"
      aria-label="Search games by title"
      autocomplete="off"
    />
    <button
      class="search-clear absolute top-1/2 right-2 grid size-7 -translate-y-1/2 cursor-pointer place-items-center rounded-md text-neutral-500 transition duration-150 hover:bg-neutral-100 hover:text-black focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black md:hidden dark:text-neutral-400 dark:hover:bg-neutral-900 dark:hover:text-white dark:focus-visible:outline-white"
      type="button"
      aria-label="Clear search"
      hidden
    >
      <X size={16} />
    </button>
  </div>
  <ul class="grid grid-cols-[repeat(auto-fill,minmax(min(10rem,100%),1fr))] gap-3 md:gap-4 lg:gap-5">
    {games.map((game) => <GameCard game={game} />)}
  </ul>
  <button
    class="random-game fixed right-4 pwa:right-6 bottom-[max(1rem,env(safe-area-inset-bottom))] pwa:bottom-[max(1.5rem,calc(env(safe-area-inset-bottom)_+_0.5rem))] z-10 grid size-12 pwa:size-14 cursor-pointer place-items-center rounded-full bg-black text-white shadow-lg transition duration-150 hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black sm:right-6 sm:pwa:right-8 dark:bg-white dark:text-black dark:focus-visible:outline-white"
    type="button"
    aria-label="Open a random game"
  >
    <Dices />
  </button>
</Layout>

<script>
  import { openInSafari } from "../scripts/open-in-browser";

  const searchInput = document.querySelector<HTMLInputElement>(".game-search");
  const searchClear = document.querySelector<HTMLButtonElement>(".search-clear");
  const cards = document.querySelectorAll<HTMLElement>(".game-card");
  const randomButton = document.querySelector<HTMLButtonElement>(".random-game");
  const gameLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".game-link"));

  if (searchInput) {
    const applySearch = () => {
      const query = searchInput.value.trim().toLowerCase();

      for (const card of cards) {
        const title = card.querySelector(".game-title")?.textContent?.trim().toLowerCase() ?? "";
        card.hidden = !title.includes(query);
      }

      if (searchClear) {
        searchClear.hidden = searchInput.value.length === 0;
      }
    };

    searchInput.addEventListener("input", applySearch);
    applySearch();

    searchClear?.addEventListener("click", () => {
      searchInput.value = "";
      applySearch();
      // Dismiss the on-screen keyboard after clearing.
      searchInput.blur();
    });
  }

  if (randomButton && gameLinks.length > 0) {
    randomButton.addEventListener("click", () => {
      const link = gameLinks[Math.floor(Math.random() * gameLinks.length)];

      if (!openInSafari(link.href)) {
        window.open(link.href, "_blank", "noopener");
      }
    });
  }
</script>

<style>
  /* The custom clear button replaces WebKit's native one on mobile. */
  @media (max-width: 767.98px) {
    .game-search::-webkit-search-cancel-button {
      -webkit-appearance: none;
      appearance: none;
    }
  }
</style>
