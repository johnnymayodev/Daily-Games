---
import { getCollection } from "astro:content";

import GameCard from "../components/GameCard.astro";
import Layout from "../layouts/Layout.astro";

const games = (await getCollection("games")).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Layout title="Daily Games">
  <input
    class="game-search"
    type="search"
    placeholder="Search games"
    aria-label="Search games by title"
    autocomplete="off"
  />
  <ul class="game-grid">
    {games.map((game) => <GameCard game={game} />)}
  </ul>
  <button
    class="random-game"
    type="button"
    aria-label="Open a random game"
  >
    Random
  </button>
</Layout>

<script>
  const searchInput = document.querySelector<HTMLInputElement>(".game-search");
  const cards = document.querySelectorAll<HTMLElement>(".game-card");
  const randomButton = document.querySelector<HTMLButtonElement>(".random-game");
  const gameLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".game-link"));

  if (searchInput) {
    searchInput.addEventListener("input", () => {
      const query = searchInput.value.trim().toLowerCase();

      for (const card of cards) {
        const title = card.querySelector(".game-title")?.textContent?.trim().toLowerCase() ?? "";
        card.hidden = !title.includes(query);
      }
    });
  }

  if (randomButton && gameLinks.length > 0) {
    randomButton.addEventListener("click", () => {
      const link = gameLinks[Math.floor(Math.random() * gameLinks.length)];
      window.open(link.href, "_blank", "noopener");
    });
  }
</script>

<style>
  .game-search {
    display: block;
    width: 100%;
    max-width: 24rem;
    margin-bottom: clamp(1rem, 3vw, 1.75rem);
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background-color: var(--bg);
    color: var(--text);
    font: inherit;
  }

  .game-search::placeholder {
    color: var(--muted);
  }

  .game-search:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 2px;
  }

  .game-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(10rem, 100%), 1fr));
    gap: clamp(0.75rem, 2vw, 1.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .random-game {
    position: fixed;
    right: clamp(1rem, 3vw, 1.5rem);
    bottom: max(clamp(1rem, 3vw, 1.5rem), env(safe-area-inset-bottom));
    z-index: 1;
    padding: 0.65rem 1.15rem;
    border: none;
    border-radius: 999px;
    background-color: var(--text);
    color: var(--bg);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    box-shadow: 0 0.5rem 1.25rem rgb(0 0 0 / 0.25);
    transition: transform 150ms ease;
  }

  .random-game:hover {
    transform: translateY(-2px);
  }

  .random-game:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 2px;
  }
</style>
