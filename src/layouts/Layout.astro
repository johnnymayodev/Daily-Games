---
import "../styles/global.css";

import SettingsDialog from "../components/SettingsDialog.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "A museum for daily games." } = Astro.props;
---

<!doctype html>
<html
  lang="en"
  class="scheme-light dark:scheme-dark"
>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta
      name="description"
      content={description}
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
    <link
      rel="apple-touch-icon"
      href="/apple-touch-icon.png"
    />
    <link
      rel="manifest"
      href="/manifest.webmanifest"
    />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#000000"
      media="(prefers-color-scheme: dark)"
    />
    <title>{title}</title>
    <script is:inline>
      // Apply the saved card-images preference before first paint so hidden cards never flash.
      try {
        if (localStorage.getItem("daily-games:card-images") === "off") {
          document.documentElement.dataset.cardImages = "off";
        }
      } catch {
        // Storage unavailable; keep the default (images enabled).
      }
    </script>
  </head>
  <body class="min-h-dvh bg-white text-black antialiased dark:bg-black dark:text-white">
    <div class="mx-auto max-w-[75rem] p-4 sm:p-6 lg:p-10">
      <header class="relative mt-2 mb-4 md:mb-6 lg:mb-8">
        <h1 class="text-center text-[0.85rem] font-semibold tracking-[0.16em] text-neutral-600 uppercase dark:text-neutral-400">
          {title}
        </h1>
        <SettingsDialog />
      </header>
      <main>
        <slot />
      </main>
    </div>
    <script>
      if (import.meta.env.PROD && "serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {
            // Registration is best effort; the site works without offline support.
          });
        });
      }
    </script>
  </body>
</html>
