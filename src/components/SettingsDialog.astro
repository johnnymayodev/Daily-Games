---
import { Settings, X } from "@lucide/astro";
---

<button
  class="settings-button absolute top-1/2 right-0 grid size-8 -translate-y-1/2 cursor-pointer place-items-center rounded-lg text-neutral-600 transition duration-150 hover:bg-neutral-100 hover:text-black focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black dark:text-neutral-400 dark:hover:bg-neutral-900 dark:hover:text-white dark:focus-visible:outline-white"
  type="button"
  aria-label="Open settings"
  aria-haspopup="dialog"
>
  <Settings size={18} />
</button>

<dialog
  class="settings-dialog m-auto w-[min(24rem,calc(100vw-2rem))] rounded-xl border border-neutral-200 bg-white p-5 text-black shadow-xl backdrop:bg-black/40 dark:border-neutral-800 dark:bg-neutral-950 dark:text-white dark:backdrop:bg-black/70"
  aria-labelledby="settings-title"
>
  <div class="mb-5 flex items-center justify-between">
    <h2
      id="settings-title"
      class="text-sm font-semibold tracking-[0.02em]"
    >
      Settings
    </h2>
    <button
      class="settings-close grid size-7 cursor-pointer place-items-center rounded-md text-neutral-500 transition duration-150 hover:bg-neutral-100 hover:text-black focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black dark:text-neutral-400 dark:hover:bg-neutral-900 dark:hover:text-white dark:focus-visible:outline-white"
      type="button"
      aria-label="Close settings"
    >
      <X size={16} />
    </button>
  </div>

  <section aria-labelledby="settings-performance-heading">
    <h3
      id="settings-performance-heading"
      class="text-xs font-semibold tracking-[0.12em] text-neutral-500 uppercase dark:text-neutral-400"
    >
      Performance
    </h3>
    <label class="mt-3 flex cursor-pointer items-center justify-between gap-4">
      <span>
        <span class="block text-sm font-medium">Card images</span>
        <span class="mt-0.5 block text-xs text-neutral-600 dark:text-neutral-400">Load game images on cards.</span>
      </span>
      <input
        class="settings-card-images peer sr-only"
        type="checkbox"
        checked
      />
      <span
        class="relative h-6 w-11 shrink-0 rounded-full bg-neutral-300 transition duration-150 peer-checked:bg-black peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-black after:absolute after:top-0.5 after:left-0.5 after:size-5 after:rounded-full after:bg-white after:shadow after:transition after:duration-150 after:content-[''] peer-checked:after:translate-x-5 dark:bg-neutral-700 dark:peer-checked:bg-white dark:peer-checked:after:bg-black dark:peer-focus-visible:outline-white"
        aria-hidden="true"
      ></span>
    </label>
  </section>

  <section
    class="settings-open-in-browser-section mt-5 border-t border-neutral-200 pt-5 dark:border-neutral-800"
    aria-labelledby="settings-links-heading"
    hidden
  >
    <h3
      id="settings-links-heading"
      class="text-xs font-semibold tracking-[0.12em] text-neutral-500 uppercase dark:text-neutral-400"
    >
      Links
    </h3>
    <label class="mt-3 flex cursor-pointer items-center justify-between gap-4">
      <span>
        <span class="block text-sm font-medium">Open games in your browser</span>
        <span class="mt-0.5 block text-xs text-neutral-600 dark:text-neutral-400">
          Open games in your browser instead of an in-app view when using the installed app.
        </span>
      </span>
      <input
        class="settings-open-in-browser peer sr-only"
        type="checkbox"
      />
      <span
        class="relative h-6 w-11 shrink-0 rounded-full bg-neutral-300 transition duration-150 peer-checked:bg-black peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-black after:absolute after:top-0.5 after:left-0.5 after:size-5 after:rounded-full after:bg-white after:shadow after:transition after:duration-150 after:content-[''] peer-checked:after:translate-x-5 dark:bg-neutral-700 dark:peer-checked:bg-white dark:peer-checked:after:bg-black dark:peer-focus-visible:outline-white"
        aria-hidden="true"
      ></span>
    </label>
  </section>
</dialog>

<script>
  import { applyCardImages, isCardImagesEnabled, storeCardImagesEnabled } from "../scripts/card-images";
  import { isInstalledApp, isOpenInBrowserEnabled, storeOpenInBrowserEnabled } from "../scripts/open-in-browser";

  const settingsButton = document.querySelector<HTMLButtonElement>(".settings-button");
  const settingsDialog = document.querySelector<HTMLDialogElement>(".settings-dialog");
  const settingsClose = document.querySelector<HTMLButtonElement>(".settings-close");
  const cardImagesToggle = document.querySelector<HTMLInputElement>(".settings-card-images");
  const openInBrowserToggle = document.querySelector<HTMLInputElement>(".settings-open-in-browser");
  const openInBrowserSection = document.querySelector<HTMLElement>(".settings-open-in-browser-section");

  // Browser hand-off only applies to the installed app, so only offer the setting there.
  if (openInBrowserSection && isInstalledApp()) {
    openInBrowserSection.hidden = false;
  }

  if (cardImagesToggle) {
    cardImagesToggle.checked = isCardImagesEnabled();

    cardImagesToggle.addEventListener("change", () => {
      const enabled = cardImagesToggle.checked;
      storeCardImagesEnabled(enabled);
      applyCardImages(enabled);
    });
  }

  if (openInBrowserToggle) {
    openInBrowserToggle.checked = isOpenInBrowserEnabled();

    openInBrowserToggle.addEventListener("change", () => {
      storeOpenInBrowserEnabled(openInBrowserToggle.checked);
    });
  }

  settingsButton?.addEventListener("click", () => settingsDialog?.showModal());
  settingsClose?.addEventListener("click", () => settingsDialog?.close());

  settingsDialog?.addEventListener("click", (event) => {
    if (event.target === settingsDialog) {
      settingsDialog.close();
    }
  });
</script>
